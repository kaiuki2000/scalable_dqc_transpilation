+
+    // Distance matrix setter: (Testing.)
+    fn set_distance_matrix(&mut self, matrix: Vec<Vec<f64>>) -> PyResult<()> {
+        let n = matrix.len();
+        if n == 0 || matrix.iter().any(|row| row.len() != n) {
+            return Err(TranspilerError::new_err(
+                "Distance matrix must be non-empty and square",
+            ));
+        }
+        let flat: Vec<f64> = matrix.into_iter().flatten().collect();
+        let array = Array2::from_shape_vec((n, n), flat).map_err(|e| {
+            TranspilerError::new_err(format!("Failed to create distance matrix: {}", e))
+        })?;
+        if let Some(target) = &mut self.0 {
+            if target.num_qubits() != n {
+                return Err(TranspilerError::new_err(format!(
+                    "Distance matrix size {} does not match number of qubits {}",
+                    n,
+                    target.num_qubits()
+                )));
+            }
+            target.distance = array;
+            Ok(())
+        } else {
+            Err(TranspilerError::new_err(
+                "Cannot set distance matrix on all-to-all target",
+            ))
+        }
+    }
